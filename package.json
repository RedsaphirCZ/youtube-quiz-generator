{
  "name": "quiz-for-youtube-generator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode static",
    "build": "vite build --base=./ --mode static",
    "build:static": "vite build --base=./ --mode static",
    "preview": "vite preview",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "npm run typecheck",
    "check:quiz-validator": "tsx scripts/check-agentic-validator.ts",
    "check:html-responsive": "tsx scripts/check-html-responsive.ts",
    "check:prompt-import": "tsx scripts/check-prompt-import.ts",
    "check:picture-quiz": "tsx scripts/check-picture-quiz.ts",
    "check:studio-settings": "tsx scripts/check-studio-settings.ts",
    "check:pdf-bleed": "tsx scripts/check-pdf-bleed.ts",
    "check:picture-assets": "tsx scripts/check-picture-assets.ts",
    "check:flag-card-studio": "tsx scripts/check-flag-card-studio.ts",
    "typecheck": "tsc --noEmit",
    "check:card-part-numbering": "tsx scripts/check-card-part-numbering.ts",
    "check:library": "tsx scripts/check-library.ts",
    "check:indexeddb": "tsx scripts/check-indexeddb.ts",
    "check": "npm run typecheck && npm run check:quiz-validator && npm run check:html-responsive && npm run check:prompt-import && npm run check:picture-quiz && npm run check:studio-settings && npm run check:pdf-bleed && npm run check:picture-assets && npm run check:flag-card-studio && npm run check:card-part-numbering && npm run check:library && npm run check:indexeddb && npm run check:language-quiz",
    "check:language-quiz": "tsx scripts/check-language-quiz.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dompurify": "^3.4.14",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
