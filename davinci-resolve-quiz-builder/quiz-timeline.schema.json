{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redsaphir.local/schemas/resolve-quiz-timeline-v1.json",
  "title": "Resolve Quiz Timeline Dataset",
  "type": "object",
  "required": ["questions"],
  "properties": {
    "id": { "type": "string" },
    "theme": { "type": "string" },
    "title": { "type": "string" },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["type", "question", "options", "correctIndex"],
            "properties": {
              "type": { "const": "mcq" },
              "question": { "type": "string", "minLength": 1 },
              "options": {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "items": { "type": "string", "minLength": 1 }
              },
              "correctIndex": { "type": "integer", "minimum": 0, "maximum": 3 },
              "explanation": { "type": "string" },
              "keyTakeaway": { "type": "string" }
            },
            "additionalProperties": true
          },
          {
            "type": "object",
            "required": ["type", "question", "target"],
            "properties": {
              "type": { "const": "number" },
              "question": { "type": "string", "minLength": 1 },
              "target": { "type": "number" },
              "unit": { "type": "string" },
              "metricUnit": { "type": "string" },
              "imperialDisplay": { "type": "string" },
              "explanation": { "type": "string" },
              "keyTakeaway": { "type": "string" }
            },
            "additionalProperties": true
          }
        ]
      }
    }
  },
  "additionalProperties": true
}
